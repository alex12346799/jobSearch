# Copy this file to .env for local development and change values if needed.
DB_NAME=jobsearch
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/jobsearch
DB_USERNAME=jobsearch
DB_PASSWORD=jobsearch_local

# Base64-encoded random value of at least 32 bytes. Generate a new local/production secret.
JWT_SECRET=replace_with_base64_encoded_random_secret_of_at_least_32_bytes
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# Optional mail configuration used by the application.
MAIL_USERNAME=local@example.com
GOOGLE_APP_PASSWORD=replace_with_local_value
